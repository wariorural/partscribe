#!/bin/sh
# Konverterer NB-Whisper medium eller large til Core ML og installerer den der
# PartScribe leter (~/Library/Application Support/PartScribe/models/).
# Ingen har publisert en Core ML-versjon av disse, så vi bygger den selv med
# argmax sine whisperkittools. Tar tid og laster ned flere GB første gang.
#
#   ./scripts/convert-nb-whisper medium
#
# Krever Homebrew. Installerer uv (Python-verktøy) hvis det mangler. Trenger
# ikke Xcode: Core ML-kompilatoren erstattes av en liten stand-in som bruker
# Core ML sin egen runtime-kompilator.
set -eu

size=${1:-}
case "$size" in
    medium | large) ;;
    *) echo "bruk: $0 medium|large" >&2; exit 64 ;;
esac

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
work="$HOME/Library/Caches/PartScribe/convert"
target="$HOME/Library/Application Support/PartScribe/models/nb-whisper-$size"
mkdir -p "$work/bin"

command -v uv >/dev/null || brew install uv

if [ ! -d "$work/whisperkittools" ]; then
    git clone -q https://github.com/argmaxinc/whisperkittools.git "$work/whisperkittools"
fi
if [ ! -x "$work/whisperkittools/.venv/bin/whisperkit-generate-model" ]; then
    uv venv -q -p 3.11 "$work/whisperkittools/.venv"
    uv pip install -q -p "$work/whisperkittools/.venv" -e "$work/whisperkittools"
fi

# whisperkittools calls `xcrun coremlcompiler`, which only ships with Xcode.
swiftc -O -o "$work/bin/coremlc" "$repo_root/scripts/coremlc.swift"
cat >"$work/bin/xcrun" <<EOF
#!/bin/sh
if [ "\$1" = coremlcompiler ] && [ "\$2" = compile ]; then exec "$work/bin/coremlc" "\$3" "\$4"; fi
exec /usr/bin/xcrun "\$@"
EOF
chmod +x "$work/bin/xcrun"

out="$work/out-$size"
rm -rf "$out"
PATH="$work/bin:$PATH" "$work/whisperkittools/.venv/bin/whisperkit-generate-model" \
    --model-version "NbAiLab/nb-whisper-$size" --output-dir "$out" || true  # decoder test fails; handled below

built="$out/NbAiLab_nb-whisper-$size"

# NB-Whisper's fp16 decoder misses argmax's 35 dB correctness bar (medium:
# ~26 dB), so the tool discards it. Rebuild just the decoder with the bar at
# 20 dB; whether the words come out right is checked on real recordings.
if [ ! -d "$built/TextDecoder.mlmodelc" ]; then
    (cd "$work/whisperkittools" && WHISPERKITTOOLS="$work/whisperkittools" PATH="$work/bin:$PATH" \
        .venv/bin/python "$repo_root/scripts/convert_decoder_only.py" "NbAiLab/nb-whisper-$size" "$out")
fi
for part in MelSpectrogram AudioEncoder TextDecoder; do
    [ -d "$built/$part.mlmodelc" ] || { echo "mangler $part.mlmodelc i $built" >&2; exit 1; }
done

rm -rf "$target"
mkdir -p "$target"
cp -R "$built"/*.mlmodelc "$target/"
# WhisperKit reads the model's dimensions and token ids from these.
snapshot=$(ls -d "$HOME/.cache/huggingface/hub/models--NbAiLab--nb-whisper-$size/snapshots/"*/ | head -1)
cp "$snapshot/config.json" "$snapshot/generation_config.json" "$target/"
echo "installert: $target"
echo "slå på i ~/.config/partscribe/config.json: \"transcription\": { \"model\": \"$size\" }"
